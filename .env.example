# Copy to .env, or let scripts/setup_env.py write .env for you.
# Comments stay on their own lines: a comment after a value becomes part of it.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Gemini API key from https://aistudio.google.com/apikey (needed when modules.ai_answers is on)
GEMINI_API_KEY=
# Owner's Telegram user id: new bookings and unanswered questions go there; empty = nobody
ADMIN_USER_ID=
# Shared secret Telegram sends with every webhook call (setup_env.py generates it)
WEBHOOK_SECRET=
# Password of the compose Postgres (setup_env.py --generated-only generates it)
POSTGRES_PASSWORD=
# Bearer token for GET /api/leads; empty = endpoint off (generated too)
ADMIN_API_TOKEN=
# Set by compose for the containers; set it yourself only to run outside Docker
DATABASE_URL=
